{
  "name": "paginas-web",
  "private": true,
  "type": "module",
  "description": "Plataforma modular de tiendas online personalizables. Vertical activo: Ropa.",
  "engines": {
    "node": ">=20.9",
    "npm": ">=10"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w tienda-ropa",
    "build": "npm run build -w tienda-ropa",
    "start": "npm run start -w tienda-ropa",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspaces",
    "validate:content": "npm run validate:content -w tienda-ropa",
    "check": "npm run typecheck && npm test && npm run validate:content"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^5.0.4"
  }
}
