{
  "name": "paginas-web",
  "private": true,
  "type": "module",
  "description": "Plataforma modular de tiendas online personalizables. Vertical activo: Ropa.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "pnpm --filter tienda-ropa dev",
    "build": "pnpm --filter tienda-ropa build",
    "start": "pnpm --filter tienda-ropa start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "validate:content": "pnpm --filter tienda-ropa validate:content",
    "check": "pnpm typecheck && pnpm test && pnpm validate:content"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  }
}
